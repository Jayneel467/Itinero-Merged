# Local secrets — copy from .env.example and fill. DO NOT COMMIT.

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

OPENAI_API_KEY=your_openai_api_key
ITINERO_MODEL=gpt-4o-mini
ITINERO_TEMPERATURE=0.3
TAVILY_API_KEY=your_tavily_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
LITEAPI_KEY=your_liteapi_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

APP_ENV=sandbox
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2
API_KEY=your_liteapi_key
LITEAPI_API_KEY=your_liteapi_key
BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_TIMEOUT_SECONDS=28
LITEAPI_MAX_RETRIES=2
LITEAPI_USE_PAYMENT_SDK=true
# Optional Stripe publishable key if LiteAPI omits publishableKey on prebook:
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Without keys in sandbox, UI accepts mock card 4242… and confirms the hold honestly.
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
AGENT_RECURSION_LIMIT=32
LOG_LEVEL=INFO

# LangSmith (optional tracing for LangChain/LangGraph agents)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=itinero

# Optional — also mirrored in itinero-web/.env.local for Next image API
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Clerk — optional; for future session token verification
CLERK_SECRET_KEY=sk_test_xxxxxxxx
