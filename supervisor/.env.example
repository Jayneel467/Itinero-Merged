# Supervisor loads these (also inherits from general_agent/.env / Travel_Agent/.env)
API_KEY=your_liteapi_sandbox_or_prod_key
LITEAPI_KEY=your_liteapi_sandbox_or_prod_key
LITEAPI_API_KEY=your_liteapi_sandbox_or_prod_key
OPENAI_API_KEY=your_openai_api_key
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN

# Production handoff — set before client demo / go-live
APP_ENV=production
ITINERO_ALLOW_MOCK_PAYMENT=false
ITINERO_AUTH_DEV=false

# Observability — set in production; health probes report unset | ready | error
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_FORMAT=json
LOG_LEVEL=INFO
SERVICE_NAME=itinero-supervisor
# Optional Cloudflare R2 (S3-compatible uploads)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=itinero-uploads
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# Hotel checkout: LiteAPI Payment SDK (Stripe) only
# ITINERO_HOTEL_PAYMENT=liteapi_sdk
LITEAPI_USE_PAYMENT_SDK=true
# Stripe pk_test_… for LiteAPI Payment SDK sandbox (hotel/flight inventory)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Itinero merchant Stripe — package flights / Itinero share (server secret NEVER in frontend)
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Optional alias for Itinero Stripe secret
# ITINERO_STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# ITINERO_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# Flight checkout: LiteAPI Payment SDK (Stripe) only
ITINERO_FLIGHT_PAYMENT=liteapi_sdk
# LiteAPI webhooks — PBO → Developer tools → Webhooks → https://YOUR_DOMAIN/api/webhooks/liteapi
# Set the same token in PBO "Authentication Token" and here:
LITEAPI_WEBHOOK_SECRET=your_liteapi_webhook_token

# Optional — shared sessions across supervisor restarts / multiple instances
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_URL=rediss://default:token@host.upstash.io:6379
# Neon Postgres — pooled connection string (ep-…-pooler). Never commit the real URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Google Sign-In (OAuth Web client id — same value as VITE_GOOGLE_CLIENT_ID in itinero/.env)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
AUTH_SECRET=generate_a_long_random_string
# Internal ops only — refunds via X-Itinero-Admin-Secret header
ITINERO_ADMIN_SECRET=generate_another_long_random_string
# Daily catalog curator (POST /api/catalog/daily) — required when APP_ENV=production
CATALOG_CURATOR_TOKEN=generate_a_long_random_curator_token

# Cheap catalog LLM for package/explore factories (NOT Vero / core OpenAI)
# Prefer Gemini Flash — set one of these; factories never use OPENAI_API_KEY by default.
CATALOG_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_key
CATALOG_LLM_MODEL=gemini-2.5-flash
# CATALOG_LLM_MAX_TOKENS=4096
# Optional Groq fallback (also cheap):
# CATALOG_LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=llama-3.3-70b-versatile
# CATALOG_LLM_ALLOW_CORE=0

# Vero dual-LLM (tools=OpenAI, plans/synth=DeepSeek). Mirror in general_agent/.env
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# VERO_LLM_COMBO=1

# Comma-separated prod frontends (no trailing slash). Example: https://app.itinero.company
CORS_ORIGINS=https://your-production-domain.com
# Phone OTP off for v1 (Google + email only). Set true when MSG91/DLT is ready.
# ITINERO_AUTH_PHONE=true
# Optional SMS (leave blank to use ITINERO_AUTH_DEV locally only)
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Email — SMTP only (Zoho): login OTP + flight/hotel booking confirmations
# Set SMTP_HEALTH_CHECK=true to run live SMTP login on /api/health/ready in production
# SMTP_HEALTH_CHECK=
# Optional: inbox for /api/feedback (defaults to support@itinero.app)
# FEEDBACK_TO_EMAIL=support@itinero.app
SMTP_HOST=smtppro.zoho.com
# India DC mailboxes: smtp.zoho.in
SMTP_PORT=587
SMTP_USER=donotreply@itinero.company
SMTP_PASSWORD=your_zoho_app_password
SMTP_FROM=Itinero <donotreply@itinero.company>
# Marketing OS — search→curate→mail delay (hours). 4 prod; 0 for staging smoke.
# MARKETING_SEARCH_MAIL_DELAY_HOURS=4
# MARKETING_SEARCH_COOLDOWN_DAYS=14
# Optional inbox for marketing_smoke --live --send
# MARKETING_SMOKE_EMAIL=you@itinero.company
# Optional — separate From for confirmations vs OTP (defaults to SMTP_FROM)
# BOOKING_FROM_EMAIL=Itinero Bookings <donotreply@itinero.company>
# OTP_FROM_EMAIL=Itinero <donotreply@itinero.company>
# Ticketmaster Discovery — server-side only (never VITE_)
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key
TICKETMASTER_CONSUMER_SECRET=your_ticketmaster_consumer_secret
# FX — Frankfurter (api.frankfurter.dev) needs no key. GET /api/fx/rates + /api/fx/convert
# Optional — live flight track (schedule/gate). ADS-B position works without a key.
AIRLABS_API_KEY=your_airlabs_api_key
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
