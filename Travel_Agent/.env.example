# LLM — Groq Qwen primary; OpenAI fallback if Groq fails
LLM_PROVIDER=groq
LLM_FALLBACK=true
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.6-27b
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=0

# LiteAPI
API_KEY=your_liteapi_sandbox_key
BASE_URL=https://api.liteapi.travel/v3.0

DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
AGENT_RECURSION_LIMIT=24
LOG_LEVEL=INFO
LITEAPI_USE_PAYMENT_SDK=false