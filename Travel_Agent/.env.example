APP_ENV=sandbox

# OpenAI GPT
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2

# LiteAPI
API_KEY=your_liteapi_key
BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_TIMEOUT_SECONDS=90
LITEAPI_SEARCH_TIMEOUT_SECONDS=90
LITEAPI_MAX_RETRIES=2
# Flight Agent: search + traveler + prebook (hold) only.
# Payment SDK / Stripe checkout is backend (supervisor + itinero web). Do not collect cards here.
# LITEAPI_USE_PAYMENT_SDK is still used by supervisor structured APIs when this package is imported.
# LITEAPI_USE_PAYMENT_SDK=true
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
AGENT_RECURSION_LIMIT=32
LOG_LEVEL=INFO

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=itinero
