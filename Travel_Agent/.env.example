APP_ENV=sandbox

# OpenAI GPT
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2

# LiteAPI
API_KEY=your_liteapi_key
BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_TIMEOUT_SECONDS=28
LITEAPI_MAX_RETRIES=2
# true = passenger pays by card (Stripe Payment SDK). false = agency CREDIT line.
LITEAPI_USE_PAYMENT_SDK=true
# Optional if LiteAPI does not return publishableKey on prebook:
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Sandbox without Stripe keys: BookingPopup accepts mock card 4242 4242 4242 4242
# and confirms with the LiteAPI hold ID (no invented airline ticket).

DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
AGENT_RECURSION_LIMIT=32
LOG_LEVEL=INFO

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=itinero
