FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Supervisor deps (+ light Travel_Agent runtime pieces used by flight imports)
COPY supervisor/requirements.txt /tmp/supervisor-requirements.txt
RUN pip install --no-cache-dir -r /tmp/supervisor-requirements.txt \
    && pip install --no-cache-dir \
        "pydantic-settings>=2.0.0" \
        "structlog>=24.0.0"

# Repo layout preserved so `supervisor.*` and sibling package paths resolve
COPY supervisor/ ./supervisor/
COPY Travel_Agent/ ./Travel_Agent/
COPY general_agent/ ./general_agent/
COPY ITINERARY_AGENT/ ./ITINERARY_AGENT/

ENV PYTHONPATH=/app
ENV SERVICE_NAME=itinero-supervisor
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "supervisor.main:app", "--host", "0.0.0.0", "--port", "8000"]
