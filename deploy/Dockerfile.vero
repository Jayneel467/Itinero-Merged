FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY general_agent/requirements.txt /tmp/ga-requirements.txt
# FastAPI server deps are used by run.py but historically lived outside requirements.txt
RUN pip install --no-cache-dir -r /tmp/ga-requirements.txt \
    && pip install --no-cache-dir "fastapi>=0.115.0" "uvicorn[standard]>=0.32.0" "httpx>=0.27.0"

COPY general_agent/ ./general_agent/
# Travel_Agent / ITINERARY_AGENT are imported by tools when available
COPY Travel_Agent/ ./Travel_Agent/
COPY ITINERARY_AGENT/ ./ITINERARY_AGENT/

ENV PYTHONPATH=/app
ENV SERVICE_NAME=itinero-vero
ENV PYTHONUNBUFFERED=1

EXPOSE 8001
CMD ["uvicorn", "general_agent.run:app", "--host", "0.0.0.0", "--port", "8001"]
