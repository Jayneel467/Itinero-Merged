# Multi-stage: build Itinero SPA → nginx with base /itinero/
FROM node:22-alpine AS build
WORKDIR /app
COPY itinero/package.json itinero/package-lock.json ./
RUN npm ci
COPY itinero/ ./
# Vite base is already /itinero/ in vite.config.js
# Browser-only vars must be ARG/ENV at build time (Vite inlines them).
ARG VITE_API_URL=/api
ARG VITE_VERO_API_URL=
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
ARG VITE_GOOGLE_CLIENT_ID=
ARG VITE_STRIPE_PUBLISHABLE_KEY=
ARG VITE_ITINERO_STRIPE_PUBLISHABLE_KEY=
ENV VITE_API_URL=$VITE_API_URL \
    VITE_VERO_API_URL=$VITE_VERO_API_URL \
    VITE_SENTRY_DSN=$VITE_SENTRY_DSN \
    VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID \
    VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY \
    VITE_ITINERO_STRIPE_PUBLISHABLE_KEY=$VITE_ITINERO_STRIPE_PUBLISHABLE_KEY
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html/itinero
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
