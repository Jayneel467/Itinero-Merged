NEXT_PUBLIC_SUPERVISOR_URL=http://127.0.0.1:8000

# Google Maps JavaScript API (browser). Copy from supervisor/general_agent GOOGLE_MAPS_API_KEY.
# Restrict by HTTP referrer: http://localhost:3000/* and your production domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Unsplash — destination / hero imagery (server-only; never expose in client bundles)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Clerk — copy real keys into .env.local only (never commit)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
