# Local dev defaults — override with production URLs before client build
VITE_API_URL=http://127.0.0.1:8000
VITE_VERO_API_URL=http://127.0.0.1:8001
# Browser Sentry (leave blank locally). npm install after pulling @sentry/react.
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# LiteAPI Payment SDK — Stripe publishable key (pk_test_… in sandbox). Hotel/flight inventory checkout.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Itinero merchant Stripe — package flights / Itinero share (pk_live_… in production)
VITE_ITINERO_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# VITE_FLIGHT_PAYMENT=liteapi_sdk
# Maps JavaScript API for /flights/track. Same GCP project as supervisor GOOGLE_MAPS_API_KEY.
# Restrict by HTTP referrer. Blank uses OpenStreetMap tiles instead.
VITE_GOOGLE_MAPS_API_KEY=
# Google Sign-In (OAuth Web client id from GCP Credentials)
VITE_GOOGLE_CLIENT_ID=
# Travelpayouts → Klook. Public campaign/marker only. Blank marker hides partner CTAs.
# Checkout still happens on Klook; we earn if the cookie converts.
VITE_KLOOK_TP_CAMPAIGN_ID=137
VITE_KLOOK_TP_MARKER=723913
VITE_KLOOK_TP_P=4110
VITE_KLOOK_TP_TRS=524247
VITE_KLOOK_LOCALE=en-IN
# Legal / trust pages (override before public launch)
# VITE_LEGAL_ENTITY_NAME=Your Company Pvt Ltd
# VITE_LEGAL_ADDRESS=Registered office city, State, India
# VITE_SUPPORT_EMAIL=support@your-domain.com
# VITE_LEGAL_EMAIL=legal@your-domain.com
# VITE_PRIVACY_EMAIL=privacy@your-domain.com
# Train e-tickets need an IRCTC-authorised PSP affiliate API (not public).
# Until that contract + keys exist, /trains/book collects passengers on-site
# then partner-handoff; PNR confirmation still comes from IRCTC.

# Production build checklist:
# VITE_API_URL=https://api.your-domain.com
# VITE_VERO_API_URL=https://vero.your-domain.com
# VITE_SENTRY_DSN=https://…@….ingest.sentry.io/…
# VITE_GOOGLE_CLIENT_ID=<same as GOOGLE_OAUTH_CLIENT_ID on supervisor>
# Then: npm install && npm run build — verify dist/ bundle does NOT contain 127.0.0.1
# (@sentry/react is in package.json — run npm install after pull)
