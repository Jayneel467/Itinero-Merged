OPENAI_API_KEY=your_openai_api_key
# Vero combo: OpenAI = tools/booking, DeepSeek = trip plans + post-tool writeups
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VERO_LLM_COMBO=1
# Capability router (supervisor) + agent envelope
VERO_LLM_ROUTER=1
VERO_RECURSION_LIMIT=28
VERO_MAX_TOOL_ROUNDS=8
VERO_AGENT_BUILD=2026.08.13.cost2
# VERO_PROMPT_VERSION=2026.08.13.2
# VERO_LLM_TIMEOUT_S=45
# Durable thread memory (sqlite default). Use memory for ephemeral tests.
VERO_CHECKPOINT=sqlite
# VERO_CHECKPOINT_PATH=/var/lib/itinero/vero_checkpoints.sqlite
TAVILY_API_KEY=your_tavily_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
LITEAPI_KEY=your_liteapi_key
# Prefer Payment SDK for hotel holds. Agency CREDIT only for sand_* keys + explicit flag:
# LITEAPI_USE_PAYMENT_SDK=true
# ITINERO_ALLOW_AGENCY_CREDIT=0
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional — Vero voice (Gujarati/Hindi/any Indic). Never commit the real key.
SARVAM_API_KEY=your_sarvam_api_key
# Optional — Ticketmaster Discovery (concerts / sports / theatre). Server-side only.
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key
TICKETMASTER_CONSUMER_SECRET=your_ticketmaster_consumer_secret
# Optional — live flight status (schedule / gate / delay). Server-side only.
# ADS-B airborne position still works without these. Never invent times or gates.
AIRLABS_API_KEY=your_airlabs_api_key
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
# FX — Frankfurter (https://api.frankfurter.dev) needs no key. Used by Vero + /api/fx.
# India trains — eRail (erail.in) needs no key. search_trains / Surat→Baroda (ST→BRC).
# India buses — Google Routes TRANSIT BUS (GOOGLE_MAPS_API_KEY). search_buses / /buses. Never invent fares.
# Visa — official source registry in general_agent/data/visa_sources.json (URLs only, no hard rules).
# check_visa uses Tavily to find gov pages, then interprets. No Timatic/Sherpa key in Stage 1.
ITINERO_MODEL=gpt-4o-mini
ITINERO_TEMPERATURE=0.3
# CFO: Vero is free. Daily AI budget + OpenAI fair-use (does not require Plus).
VERO_DAILY_BUDGET_USD=80
VERO_OPENAI_TURNS_PER_DEVICE_DAY=12
# Claude-style daily credits (Free vs Plus pool). Chat=1, live tools=4.
VERO_FREE_DAILY_CREDITS=40
VERO_PLUS_DAILY_CREDITS=200
# VERO_COST_WINDOW_CHEAP=12
# VERO_COST_WINDOW_TOOLS=16
# Comma-separated prod frontends allowed to call Vero (same as supervisor CORS_ORIGINS)
CORS_ORIGINS=https://your-production-domain.com

# Observability
APP_ENV=production
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_FORMAT=json
SERVICE_NAME=itinero-vero

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=itinero
