        <mxCell id="wa6"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf6"  target="wf7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa7"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf7"  target="wf8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa8"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf8"  target="wf9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa9"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf9"  target="wf10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf10" target="wf11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf11" target="wf12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf12" target="wf13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf13" target="wf14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="flow_container" source="wf14" target="wf15"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MAIN ARROWS: User ↔ Itinerary Agent                        -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="arrow_user_to_ia"
                value="Messages / Selections / Confirmations"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;
                       fontSize=10;fontStyle=2;strokeColor=#666666;
                       exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
                edge="1" parent="1" source="user" target="itinerary_container">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_ia_to_user"
                value="Agent Responses / Options / Itinerary"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;
                       fontSize=10;fontStyle=2;strokeColor=#666666;
                       exitX=0.4;exitY=0;entryX=0.4;entryY=1;"
                edge="1" parent="1" source="itinerary_container" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Itinerary Agent → Flight Agent (delegated instruction) -->
        <mxCell id="arrow_ia_to_fa"
                value="NL Instruction: search/filter/rank/prebook flights"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;
                       fontSize=9;fontStyle=2;strokeColor=#82b366;
                       exitX=0.2;exitY=1;entryX=0.5;entryY=0;"
                edge="1" parent="1" source="itinerary_container" target="flight_container">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_fa_to_ia"
                value="FlightAgentResponse (structured JSON)"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;
                       fontSize=9;fontStyle=2;strokeColor=#82b366;dashed=1;
                       exitX=0.6;exitY=0;entryX=0.25;entryY=1;"
                edge="1" parent="1" source="flight_container" target="itinerary_container">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Itinerary Agent → Hotel Agent (delegated instruction) -->
        <mxCell id="arrow_ia_to_ha"
                value="NL Instruction: search/filter/rank/prebook hotels per day"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;
                       fontSize=9;fontStyle=2;strokeColor=#d6b656;
                       exitX=0.8;exitY=1;entryX=0.5;entryY=0;"
                edge="1" parent="1" source="itinerary_container" target="hotel_container">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_ha_to_ia"
                value="HotelAgentResponse (structured JSON)"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;
                       fontSize=9;fontStyle=2;strokeColor=#d6b656;dashed=1;
                       exitX=0.4;exitY=0;entryX=0.75;entryY=1;"
                edge="1" parent="1" source="hotel_container" target="itinerary_container">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LEGEND                                                       -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="legend"
                value="Legend"
                style="swimlane;startSize=25;fillColor=#ffffff;strokeColor=#aaaaaa;
                       fontSize=11;fontStyle=1;arcSize=4;"
                vertex="1" parent="1">
          <mxGeometry x="100" y="1000" width="450" height="120" as="geometry" />
        </mxCell>

        <mxCell id="leg_ia" value="Itinerary Agent (Blue)"   style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="legend"><mxGeometry x="10" y="35" width="90" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_fa" value="Flight Agent (Green)"     style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="legend"><mxGeometry x="115" y="35" width="90" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_ha" value="Hotel Agent (Orange)"     style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="legend"><mxGeometry x="220" y="35" width="90" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_sm" value="State Management (Purple)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="legend"><mxGeometry x="325" y="35" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_user" value="User (Gray)"            style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="legend"><mxGeometry x="10" y="75" width="90" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_gate" value="Confirmation Gate (Yellow)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6ae00;fontSize=10;" vertex="1" parent="legend"><mxGeometry x="115" y="75" width="130" height="30" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
